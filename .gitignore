# Claude Code project state (settings.json is tracked project policy, not personal config)
.claude/*
!.claude/settings.json

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Model weights & derived data artifacts (large binaries, not tracked)
models/
*.gguf
*.safetensors
*.bin
*.pt
*.ckpt

# llama.cpp checkout (cloned by scripts/build_llama_cpp.sh, not vendored)
third_party/

# Generated eval data (reproducible from scripts/prepare_eval_data.py)
eval/data/*
!eval/data/.gitkeep

# Benchmark outputs (raw run logs are large and machine-specific, not tracked)
results/*
!results/.gitkeep

# ...except the small eval diagnostics cited in the write-up. Note the
# re-include of results/logs/ is required first: git will not un-ignore a file
# whose parent directory is itself excluded by results/*.
!results/logs/
results/logs/*
!results/logs/instr_eval_cakld.log
!results/logs/instr_eval_diag_*.json

# OS
.DS_Store
