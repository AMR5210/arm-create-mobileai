.claude/*
CLAUDE.md
docs/DEVPOST_SUBMISSION.md
docs/SUBMISSION_CHECKLIST.md
docs/images/devpost-thumbnail.png

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Model weights & derived data artifacts (large binaries, not tracked)
models/
*.gguf
*.safetensors
*.bin
*.pt
*.ckpt

# llama.cpp checkout (cloned by scripts/build_llama_cpp.sh, not vendored)
third_party/

# Generated eval data (reproducible from scripts/prepare_eval_data.py)
eval/data/*
!eval/data/.gitkeep

# Benchmark outputs (raw run logs are large and machine-specific, not tracked)
results/*
!results/.gitkeep
!results/wikitext2_perplexity.json
!results/c4_perplexity.json

# ...and the per-variant on-device benchmark records plus the table generated
# from them. These are the reported submission numbers, each ~3 KB, and each
# records the SHA-256 of the model file it measured.
!results/baseline-fp16.json
!results/ptq-2bit.json
!results/qat-2bit.json
!results/summary.md
!results/summary.csv

# ...except the small eval diagnostics cited in the write-up. Note the
# re-include of results/logs/ is required first: git will not un-ignore a file
# whose parent directory is itself excluded by results/*.
!results/logs/
results/logs/*
!results/logs/instr_eval_cakld.log
!results/logs/instr_eval_diag_*.json
# ...and the distilled QAT/ablation training log (config + every-50-step lines
# only, ~14 KB -- the raw logs it is cut down from stay untracked).
!results/logs/qat_ablation_runs.log

# OS
.DS_Store
