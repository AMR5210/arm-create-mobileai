Frameworks/

# Model + eval resources are copied in by stage_resources.sh; they are large
# binaries reproducible from the desktop pipeline, so they stay untracked
# (mirrors the root .gitignore rules for models/ and eval/data/).
LlamaBench/Resources/*.gguf
LlamaBench/Resources/wikitext2_test.txt
LlamaBench/Resources/instruction_eval.jsonl

# On-device benchmark JSON pulled back off the phone lands in ../results/
